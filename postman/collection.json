    {
      "name": "Recipients",
      "description": "Sales managers (one region each) and heads (overall report). Stored in SQLite.\n\nRun this folder top to bottom: **Add recipient** saves the new id and invite code into the collection variables `newRecipientId` and `inviteCode`, **Add recipient (head)** saves `headRecipientId`, and the two delete requests remove both again at the end.",
      "item": [
        {
          "name": "List recipients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipients"
              ]
            },
            "description": "All recipients with role, region, chat ID, `connected` (true when a chat ID is set), invite link (null without a bot token) and last send."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is a list\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "id": "5a8abc58-12a3-5911-8c08-b4ef114a6841"
        },
        {
          "name": "Add recipient (manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipients"
              ]
            },
            "description": "Add a sales manager. `role` is `manager` (needs `region`) or `head` (no region). `chat_id` is optional: without it the recipient cannot be sent to until it is filled in or the invite link is opened.\n\nSaves `newRecipientId` and `inviteCode` for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Manager\",\n  \"role\": \"manager\",\n  \"region\": \"Jawa Barat\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"newRecipientId\", r.id);",
                  "pm.collectionVariables.set(\"inviteCode\", r.invite_code);",
                  "pm.test(\"not connected yet\", () => pm.expect(r.connected).to.be.false);"
                ]
              }
            }
          ],
          "id": "e5f21e80-14ea-5b62-aee6-ca89088a3a16"
        },
        {
          "name": "Add recipient (head)",
          "request": {
            "method": "POST",
