          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"5 weakest outlets\", () => pm.expect(d.weakest).to.have.lengthOf(5));",
                  "pm.test(\"has summary\", () => pm.expect(d.summary).to.be.a(\"string\").and.not.empty);"
