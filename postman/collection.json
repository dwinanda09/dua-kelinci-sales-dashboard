        {
          "name": "Delete recipient",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipients/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipients",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{newRecipientId}}"
                }
              ]
            },
            "description": "Delete a recipient (and its send log). Returns 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
