# Copy to .env (./setup.sh does this for you) and fill in what you need.
# Only TELEGRAM_BOT_TOKEN is needed for the bot; everything else has a default.

# --- Dashboard ---
# Port on your machine for the dashboard: http://localhost:8000
APP_PORT=8000
TZ=Asia/Jakarta

# --- Telegram bot (optional) ---
# Get a token from @BotFather on Telegram: send /newbot and follow the steps.
# Leave empty to run the dashboard only.
TELEGRAM_BOT_TOKEN=

# Who may use the bot. Comma-separated chat IDs; empty = anyone who finds the bot.
# Send /chatid to the bot to see an ID. A group chat ID starts with "-".
TELEGRAM_ALLOWED_CHAT_IDS=

# Who may send reports to sales managers with /kirim in the bot. Comma-separated chat IDs.
# (Sending from the dashboard's "Kirim Telegram" tab needs no admin ID.)
TELEGRAM_ADMIN_CHAT_IDS=

# Daily summary: chat IDs that receive /ringkasan automatically, and when (24h, TZ above).
# Empty = no automatic summary.
TELEGRAM_DIGEST_CHAT_IDS=
DIGEST_TIME=08:00

# Link the bot sends for /dashboard.
DASHBOARD_URL=http://localhost:8000
